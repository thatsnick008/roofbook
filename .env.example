# --- Auth (native email/password, no external accounts needed) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-long-random-string

# --- Database (Neon Postgres via the Vercel Marketplace) ---
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- Document vault (Vercel Blob; auto-injected on Vercel) ---
BLOB_READ_WRITE_TOKEN=

# --- Email reminders (optional; skip if you do not want email alerts) ---
RESEND_API_KEY=
REMINDER_FROM_EMAIL="Roofbook <onboarding@resend.dev>"
CRON_SECRET=generate-a-long-random-string


